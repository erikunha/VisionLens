{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.visionlens.example/candidate/p3/problem-details.v1.schema.json",
  "title": "VisionLens Phase III candidate problem-details.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "status",
    "code",
    "requestId",
    "retryable"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string"
    },
    "instance": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9._:@-]+$"
    },
    "retryable": {
      "type": "boolean"
    }
  }
}
