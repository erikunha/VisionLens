{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.visionlens.example/candidate/p3/job-result.v1.schema.json",
  "title": "VisionLens Phase III candidate job-result.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "operation",
        "taskKind",
        "artifacts",
        "provenance"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9._:@-]+$"
        },
        "operation": {
          "const": "vision.predict"
        },
        "taskKind": {
          "const": "image.classification"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifactId",
              "mediaType",
              "sha256",
              "byteLength",
              "accessTier"
            ],
            "properties": {
              "artifactId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[a-zA-Z0-9._:@-]+$"
              },
              "mediaType": {
                "type": "string",
                "minLength": 3
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0
              },
              "accessTier": {
                "enum": [
                  "workspace",
                  "restricted",
                  "public-demo"
                ]
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputSha256",
            "modelRevision",
            "preprocessFingerprint",
            "contractVersion"
          ],
          "properties": {
            "inputSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "modelRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[a-zA-Z0-9._:@-]+$"
            },
            "preprocessFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "contractVersion": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "contractVersion"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9._:@-]+$"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    }
  }
}
