{
  "name": "@vision-lens/cli",
  "version": "0.0.1",
  "description": "Vision Lens CLI: the canonical `vision-lens` bin (spec 001 US2).",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vision-lens": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run --root ../.. packages/cli --testTimeout 15000",
    "test:bins": "pnpm --filter @vision-lens/cli --filter @vision-lens/core run build && vitest run --root ../.. packages/cli --testTimeout 15000"
  },
  "dependencies": {
    "@vision-lens/core": "workspace:*",
    "chalk": "5.6.2",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@types/node": "25.6.2"
  }
}
